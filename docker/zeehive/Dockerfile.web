# ZEEHIVE production dashboard — the REAL prod artifact: the built bundle behind nginx, not a
# vite dev server that happens to be running. /api (including the SSE stream) proxies to the
# queenzee API on the host — see nginx-web.conf.
#
# Build context is the REPO ROOT (see docker-compose.prod.yml): the web workspace needs the root
# package-lock for a reproducible install.
FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY web/package.json web/
RUN npm ci --workspace web
COPY web/ web/
RUN npm --workspace web run build

FROM nginx:alpine
COPY docker/zeehive/nginx-web.conf /etc/nginx/conf.d/default.conf
# WHERE /api lives. Default = the prod shape (queenzee on the host / sibling container reached
# via the host gateway) — an argless build is byte-identical to before this ARG existed. The
# GENERATED spinoff compose overrides it to its own sibling server service ("server:4700"), so
# a per-xell webapp talks to ITS OWN nested queenzee wherever the stack runs — including a
# remote machine, where host.docker.internal:4700 would name the wrong (or no) API.
ARG ZEEHIVE_API_UPSTREAM=host.docker.internal:4700
RUN sed -i "s|host\.docker\.internal:4700|${ZEEHIVE_API_UPSTREAM}|g" /etc/nginx/conf.d/default.conf
COPY --from=build /src/web/dist /usr/share/nginx/html
EXPOSE 5180
