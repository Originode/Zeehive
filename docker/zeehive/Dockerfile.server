# ZEEHIVE queenzee — containerized orchestrator. EXPERIMENTAL (compose profile: experimental):
# building this image works today; RUNNING it as the live queenzee waits on the repo migration
# below. The blocker is not the process, it is the FILES: the queenzee's job is cutting git
# worktrees that agent sessions work in, and a worktree's .git file stores an absolute gitdir
# path that only resolves on the side that wrote it. A Linux queenzee minting /repos/... paths
# strands every Windows-host session (and the meta-DB is full of D:/ paths from the host era).
#
# The sanctioned migration (agreed 2026-07-18): move the PROJECT FOLDERS to the Linux side —
# repos live on a named volume (or a WSL distro's ext4), this container and its headless zees
# (in-container `claude` CLI) do all git natively there, and Windows visits via
# \\wsl.localhost\... / VS Code Remote instead of owning the files. Until that lands, the live
# queenzee stays a host process (the self-ship pattern) and this image is the runway.
#
# What the runtime needs, and why:
#   git + bash        — every provisioning/land/reap/build script
#   docker CLI        — drives the fleet daemons (mounted socket for local, TCP contexts beyond)
#   claude CLI        — spawns headless zees as child processes (auth: mount a logged-in
#                       ~/.claude or pass ANTHROPIC_API_KEY; see compose)
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      git bash ca-certificates curl openssh-client psmisc procps \
    && rm -rf /var/lib/apt/lists/*
# docker CLI only (no daemon) — the static binary from the official CLI image, plus the compose
# plugin: the container-era self-ship rebuilds and recreates its own service via `docker compose`
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
# buildx CLI plugin, ALONGSIDE compose in the same plugin dir the docker CLI already searches.
# Compose v2 drives `docker compose build` through buildx; without it, compose warns and falls
# back to the LEGACY builder, which cannot run `RUN --mount`, `--secret`, `--ssh` or honor a
# `# syntax=` directive — so any prod Dockerfile using a BuildKit feature fails to ship
# (seen live: OmniBiz webapp, "the --mount option requires BuildKit"). Pinned (not :latest) for
# reproducible prod-build images. Static Go binary → arch (linux/amd64) is all that matters here.
COPY --from=docker/buildx-bin:0.35.0 /buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
RUN chmod +x /usr/local/libexec/docker/cli-plugins/docker-buildx \
    && docker buildx version
RUN npm install -g @anthropic-ai/claude-code

WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json server/
RUN npm ci --workspace server
COPY server/ server/
COPY scripts/ scripts/
COPY db/ db/
COPY hooks/ hooks/
COPY skill/ skill/
# NO `COPY harnesses/` — deliberately. A file-backed harness (harness.dir = 'harnesses/manager') is
# a projection of files in the ZEEHIVE PROJECT's repo (project.repo_root, the clone under /repos),
# and lib/harness.js resolves it there; a second copy baked into this image would drift from the
# repo the DB row claims to project — the same reasoning as the single copy of scripts/zee.
# (Until 2026-07-29 harness.js resolved against config.repoRoot = /app instead, which is why the
# deployed queenzee handed every manager zee an empty harness. See HANDOFF.md, ticket #1.)
# The repo checks out CRLF on Windows and COPY preserves it; bash then reads `set -euo pipefail\r`
# as an invalid option and every provisioning script dies (seen live: pool provision 2026-07-20).
# Same normalization Dockerfile.zee-agent applies to its cxell scripts.
RUN find scripts hooks -type f \( -name '*.sh' -o -name '*.mjs' -o -name 'zee' \) -exec sed -i 's/\r$//' {} +

# Entrypoint creates the remote docker contexts (ugreen-nas / mardale-prod) from env, then execs
# the server — see entrypoint-server.sh. CRLF-strip like the zee-agent scripts (repo is Windows).
COPY docker/zeehive/entrypoint-server.sh /usr/local/bin/entrypoint-server.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint-server.sh && chmod +x /usr/local/bin/entrypoint-server.sh
# The Langfuse plugin's compose file + auto-login page — lib/langfuse.js resolves them via
# config.repoRoot (/app), so a containerized queenzee must ship them (NOT covered by `COPY server/`).
COPY docker/zeehive/docker-compose.langfuse.yml /app/docker/zeehive/docker-compose.langfuse.yml
COPY docker/zeehive/langfuse-auto-login.html /app/docker/zeehive/langfuse-auto-login.html

ENV NODE_NO_WARNINGS=1
EXPOSE 4700
ENTRYPOINT ["/usr/local/bin/entrypoint-server.sh"]
