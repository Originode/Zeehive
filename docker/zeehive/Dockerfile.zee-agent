# ZEEHIVE zee-agent — the CXELL a headless zee runs in. One container per xell.
#
# BUILD CONTEXT IS THE REPO ROOT (like Dockerfile.server / Dockerfile.web):
#   docker build -f docker/zeehive/Dockerfile.zee-agent -t zeehive/zee-agent .
# It has to be, because the image bakes the AUTHORITATIVE `scripts/zee` CLI — and a
# docker/zeehive context cannot COPY out of scripts/. That used to be "solved" by keeping a
# hand-synced duplicate at docker/zeehive/zee with a comment saying "update both"; the duplicate
# then missed the crew verbs (zees/dispatch/say/report/inbox/suggest-done) for every cxell in the
# fleet — a manager zee in a cage could not dispatch at all. A comment is not a mechanism. One
# file, one COPY, and the root .dockerignore keeps the context lean.
# NOTE: every COPY source below is therefore REPO-ROOT-relative (docker/zeehive/… , scripts/…).
#
# Confinement is structural, not prompted: the container sees ONLY
#   /work            — a private clone of the xell's branch (from a git bundle; no
#                      shared object store with the xource, no host mounts)
#   its xell network — the xell's own db/app containers resolve; nothing else routes
#   the queenzee API — reached with a per-xell scoped token (minted at provision)
# It gets NO docker socket, NO docker CLI, NO host filesystem, NO ~/.claude mount.
# Auth arrives as CLAUDE_CODE_OAUTH_TOKEN (claude setup-token) or ANTHROPIC_API_KEY
# in the environment — never as a mounted credential file.
#
# The CLI runs as the non-root user `zee` (required for bypassPermissions inside
# the cxell) with `--bare` so nothing host-side (plugins/MCP/hooks/skills) leaks in.
# openssh-server + tmux: a human ATTENDS a cxell zee over SSH — the built-in dashboard terminal
# (ssh2 → xterm.js) and Claude Code desktop's "Add SSH host" are the SAME inbound door. SSH is
# inbound, so the egress-only firewall (OUTPUT DROP) neither blocks it nor is loosened by it.
# tmux keeps the interactive session alive across disconnects (true async, come-back-whenever).
FROM node:22-bookworm-slim
# adb: the ONE tool a zee needs to drive a DEVICE xhip — connect over network adb, install an APK,
# launch it, screencap, logcat. It must be CURRENT platform-tools, NOT Debian's `android-tools-adb`:
# that package ships adb 29.0.6 (2019), which predates Android 11 WIRELESS DEBUGGING — it has no
# `adb pair` and can't do the TLS `adb connect`, so against a modern phone on a dynamic TLS port it
# just times out to `offline` (diagnosed live, 2026-07-28: a wireless-debug device at :42005 was
# unreachable from adb 29, reachable from a current one). The slim base's whole purpose is to DRIVE a
# device, so it carries an adb new enough to. Pinned like the -android variant's SDK; bump deliberately.
# The heavier JDK+Android SDK to BUILD an APK stays out of the base — an Android project uses the
# zee-agent-android VARIANT via the CXELL_IMAGE override for that.
ARG PLATFORM_TOOLS_VERSION=r35.0.2
RUN apt-get update && apt-get install -y --no-install-recommends \
      git bash ca-certificates curl unzip iptables dnsutils openssh-server tmux \
    && curl -fsSL "https://dl.google.com/android/repository/platform-tools_${PLATFORM_TOOLS_VERSION}-linux.zip" -o /tmp/pt.zip \
    && unzip -q /tmp/pt.zip -d /opt \
    && ln -sf /opt/platform-tools/adb /usr/local/bin/adb \
    && rm -f /tmp/pt.zip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd
# ALL vendor-native agent CLIs bake into the one image — which one runs is decided per dispatch
# by the provider's token (server/src/lib/cxell-runtimes.js picks the adapter):
#   claude (Anthropic), codex (OpenAI, `codex exec` headless), kimi (Moonshot Kimi Code CLI,
#   `kimi -p` headless; needs Node >= 22.19, satisfied by the node:22 base), grok (xAI Grok Build,
#   `grok -p` headless — an npm wrapper that pulls its own platform binary on postinstall).
# kimi-code and grok are PINNED (young CLIs, moving fast — bump deliberately, not on every
# rebuild); claude/codex track latest like the image always has for claude.
RUN npm install -g @anthropic-ai/claude-code @openai/codex @moonshot-ai/kimi-code@0.28.1 \
      @xai-official/grok@0.2.118
COPY docker/zeehive/cxell-firewall.sh /usr/local/bin/cxell-firewall.sh
COPY docker/zeehive/cxell-sshd.sh /usr/local/bin/cxell-sshd.sh
# The cxell zee's workflow CLI (land/ship/prod/done/status/crew → the queenzee's /api/xell/self/*
# verbs), copied straight from the ONE authoritative source, scripts/zee. No duplicate to sync.
# Belt-and-braces: the queenzee ALSO docker-cp's its own current scripts/zee into every cxell at
# spawn (server/src/lib/cxell.js: installZeeCliIntoCxell), so a fleet still running an older
# zee-agent image can never hand a zee a CLI older than the queenzee that defines its API.
COPY scripts/zee /usr/local/bin/zee
# The ATTEND path: cxell-claude-seed.mjs pre-answers Claude Code's first-run gauntlet (so an
# attending human sees ZERO onboarding/theme/trust/bypass prompts); zee-attach.sh + zee-live.mjs
# land that human straight in the zee's live workflow, then `claude --resume` for the full session.
COPY docker/zeehive/cxell-claude-seed.mjs /usr/local/bin/cxell-claude-seed.mjs
COPY docker/zeehive/zee-live.mjs /usr/local/bin/zee-live.mjs
COPY docker/zeehive/zee-attach.sh /usr/local/bin/zee-attach.sh
# Belt-and-suspenders CRLF strip: .gitattributes pins these to LF, but if the build context was
# checked out on Windows with autocrlf=true (or copied through a Windows tool) a `#!/usr/bin/env
# node\r` shebang would make `zee` die with `node\r: No such file or directory`. Strip any trailing
# CR from the shebang-bearing scripts BEFORE chmod so `zee` (and the .sh/.mjs helpers) run bare.
RUN sed -i 's/\r$//' /usr/local/bin/cxell-firewall.sh /usr/local/bin/cxell-sshd.sh /usr/local/bin/zee \
             /usr/local/bin/cxell-claude-seed.mjs /usr/local/bin/zee-live.mjs /usr/local/bin/zee-attach.sh \
    && chmod +x /usr/local/bin/cxell-firewall.sh /usr/local/bin/cxell-sshd.sh /usr/local/bin/zee \
             /usr/local/bin/cxell-claude-seed.mjs /usr/local/bin/zee-live.mjs /usr/local/bin/zee-attach.sh

RUN useradd -m -s /bin/bash zee \
    && mkdir -p /work && chown zee:zee /work \
    && mkdir -p /home/zee/.ssh && chmod 700 /home/zee/.ssh && chown zee:zee /home/zee/.ssh \
    # The SHARED npm cache mountpoint (ticket #7). It exists in the image, owned by `zee`, purely so
    # that the first cxell to mount the fleet's cache VOLUME here initializes it with that ownership
    # — docker seeds a new named volume from the image path, and a root-owned cache would give npm
    # (which runs as zee) EACCES on every install. NOT a cache: nothing is baked in, and project
    # node_modules deliberately never are — the image is shared by every project and would go stale
    # against each one's lockfile. See server/src/lib/npm-cache.js.
    && mkdir -p /npm-cache && chown zee:zee /npm-cache
USER zee
WORKDIR /work
ENV NODE_NO_WARNINGS=1 \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Bake the answered first-run config into the zee user's home so it is present BEFORE any claude
# launch (the headless run and the very first terminal attach both read it). cxell-sshd.sh re-runs
# the same idempotent seed at spawn as a belt-and-suspenders across future image changes.
RUN node /usr/local/bin/cxell-claude-seed.mjs /home/zee/.claude.json && chmod 600 /home/zee/.claude.json

# git identity for in-cxell commits. TKT-159-3139: the baked config is the DOOR identity
# (user.name = the xell door), and the per-xell spawn override (cxell.js configureCxellGitIdentity)
# sets the door email to <slug>@xell.zeehive.local; the AUTHOR of every commit names the acting zee
# slug via GIT_AUTHOR_NAME/GIT_AUTHOR_EMAIL (set at spawn in /etc/environment and the headless
# exec env). This baked line is only the fallback for a cage spawned before the override ran.
RUN git config --global user.name "xell" \
    && git config --global user.email "xell@xell.zeehive.local" \
    && git config --global init.defaultBranch main

# tmux runs fullscreen (alternate buffer), so the dashboard's xterm has no scrollback of its
# own — without mouse mode the wheel does nothing. Baked here for fresh cxells; the terminal
# bridge also sets it per-attach so pre-existing cxells behave the same.
RUN printf 'set -g mouse on\nset -g history-limit 50000\n' > /home/zee/.tmux.conf

# The queenzee execs the actual run; idle keeps the cxell warm between turns.
CMD ["sleep", "infinity"]
