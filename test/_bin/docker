#!/usr/bin/env bash
# Fake `docker` for the land-loop test — records every invocation (argv + stdin) to $DOCKER_LOG so
# the test can assert the queenzee tried to RESUME the cxell session. Answers the one read the nudge
# makes (cat /etc/environment) with fake tokens; everything else just logs and succeeds.
LOG="${DOCKER_LOG:-/tmp/fake-docker.log}"
{
  echo "=== docker $* ==="
} >> "$LOG"
# EARLY-CLOSE simulation: read only a few bytes then exit WITHOUT draining stdin, so a large
# payload write hits a closing pipe (EPIPE) mid-stream — the exact failure a multi-MB image
# attachment can trigger against `docker exec -i`. Lets the message test prove dk surfaces it.
if [ "${DOCKER_FAKE_EARLY_CLOSE:-}" = "1" ] && [ ! -t 0 ]; then
  head -c 16 >/dev/null 2>&1 || true
  exit 0
fi
# SLOW-STDIN simulation: the argv line above is on disk the instant docker starts, but the PROMPT
# only reaches the log after this process has finished reading stdin. On a loaded box that gap is
# real, and a test that asserts on the prompt after merely seeing `--resume` reads the gap as a
# broken protocol (ticket #19 — the go-around "flake"). This knob makes the gap deterministic so a
# wait that is too loose fails every time instead of one run in thirty.
if [ -n "${DOCKER_FAKE_SLOW_STDIN_MS:-}" ]; then
  sleep "$(awk "BEGIN{print ${DOCKER_FAKE_SLOW_STDIN_MS}/1000}")"
fi
# read stdin (the resume prompt) if any, record it
if [ ! -t 0 ]; then
  IN="$(cat)"
  if [ -n "$IN" ]; then printf 'STDIN<<\n%s\n>>STDIN\n' "$IN" >> "$LOG"; fi
fi
for a in "$@"; do
  if [ "$a" = "/etc/environment" ]; then
    printf 'ANTHROPIC_AUTH_TOKEN=sk-ant-fake-tok\nZEEHIVE_XELL_TOKEN=fake-ident-tok\n'
    exit 0
  fi
done
exit 0
