node_modules/
dist/
# Vendored third-party packages ship their own dist/ — keep those (wterm is one).
!web/vendor/**/dist/
!web/vendor/**/dist/**
build/
.env
.env.local
# The generated NetBird control-plane config (docker/zeehive/netbird/management.json or the
# bootstrap install's own netbird/). It carries the datastore encryption key and relay secret, so
# the mesh-control-plane bootstrap step writes it and it must NEVER ride into a landing. The
# committed example (management.json.example) is the template; this rule ignores only the live file.
netbird/management.json
*.log
npm-debug.log*
.DS_Store
coverage/
.vite/
web/dist/
*.dump
data/
.zeehive.env
# INJECTED, not authored: the queenzee writes a xell's harness (persona + memory) into
# .zeehive/harness/ at provision. It is per-xell state, and it has now been swept into a commit by
# a `git add -A` twice — ignore it so there is no third time.
.zeehive/
.claude/

# Messages the queenzee DELIVERS into a xell (`zee say` / inbox drops). Per-xell runtime data,
# not source — and a tracked drop directory means every cxell that runs `git add -A` commits its
# own mail into an unrelated landing.
.zee-inbox/
